    "country-flag-icons": "1.5.13",
    "cron-parser": "4.9.0",
    "cronstrue": "2.52.0",
    "fast-xml-parser": "4.5.1",
    "lucide-react": "0.462.0",
    "luxon": "3.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
