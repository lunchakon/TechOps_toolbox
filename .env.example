# Copy to .env to override defaults used by docker-compose.yml
# Host port the app is published on (default 8088)
TECHOPS_PORT=8088
# Interface to bind. 127.0.0.1 = this machine only (default).
# Use 0.0.0.0 for LAN access, or your Tailscale IP (tailscale ip -4) for tailnet-only access.
TECHOPS_BIND=127.0.0.1
